---
import { Image } from 'astro:assets';
import logo from '@/assets/logo-sove.png';

const navLinks = [
  { href: '/a-propos',  label: 'Découvrir' },
  { href: '/soins',     label: 'Les soins' },
  { href: '/tarifs',    label: 'Tarifs'    },
  { href: '/contact',   label: 'Réserver'  },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-sable/90 backdrop-blur-sm border-b border-soie">
  <!-- Lien d'évitement pour accessibilité -->
  <a
    href="#contenu-principal"
    class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 btn-primary text-xs"
  >
    Aller au contenu
  </a>

  <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" aria-label="SOVÉ — Retour à l'accueil" class="flex-shrink-0">
      <Image
        src={logo}
        alt="SOVÉ"
        width={60}
        height={60}
        class="h-12 w-auto mix-blend-multiply"
      />
    </a>

    <!-- Navigation desktop -->
    <nav aria-label="Navigation principale">
      <ul class="hidden md:flex items-center gap-8">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={[
                'nav-link',
                currentPath.startsWith(href) && 'after:w-full',
              ]}
              aria-current={currentPath.startsWith(href) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Bouton menu mobile -->
    <button
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu-mobile"
      aria-label="Ouvrir le menu"
      class="md:hidden flex flex-col gap-1.5 p-2 focus-visible:outline-sauge"
    >
      <span class="block w-6 h-px bg-argile transition-all duration-300" aria-hidden="true"></span>
      <span class="block w-6 h-px bg-argile transition-all duration-300" aria-hidden="true"></span>
      <span class="block w-4 h-px bg-argile transition-all duration-300" aria-hidden="true"></span>
    </button>
  </div>

  <!-- Menu mobile -->
  <nav
    id="menu-mobile"
    aria-label="Navigation mobile"
    class="hidden md:hidden border-t border-soie bg-sable"
  >
    <ul class="flex flex-col px-6 py-6 gap-6">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={[
              'nav-link text-sm',
              currentPath.startsWith(href) && 'after:w-full',
            ]}
            aria-current={currentPath.startsWith(href) ? 'page' : undefined}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<!-- Espace compensateur pour le header fixe -->
<div class="h-[73px]" aria-hidden="true"></div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu   = document.getElementById('menu-mobile');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Fermer le menu' : 'Ouvrir le menu');
  });

  // Fermer le menu au clic sur un lien
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Ouvrir le menu');
    });
  });
</script>
