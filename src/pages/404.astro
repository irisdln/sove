---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page introuvable"
  description="Cette page n'existe pas — SOVÉ, soins énergétiques à domicile."
>
  <section class="min-h-[60vh] flex flex-col items-center justify-center text-center px-6 py-24">
    <div class="max-w-md mx-auto flex flex-col items-center gap-6">
      <span class="font-serif text-7xl font-light text-sauge" aria-hidden="true">404</span>
      <h1 class="font-serif text-3xl tracking-titre text-argile">Page introuvable</h1>
      <p class="text-argile/70 leading-lecture">
        Cette page n'existe pas ou a été déplacée.
      </p>
      <a href="/" class="btn-primary mt-4">Retour à l'accueil</a>
    </div>
  </section>
</BaseLayout>
