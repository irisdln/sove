---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import photoSite from '@/assets/photo_site.jpg';
---

<BaseLayout
  title="À propos"
  description="Découvrez le parcours et l'approche d'Iris, praticienne en soins énergétiques à domicile à Belfort."
>

  <!-- En-tête de page -->
  <section aria-labelledby="apropos-titre" class="py-20 px-6 text-center bg-soie">
    <div class="max-w-2xl mx-auto">
      <h1 id="apropos-titre" class="section-title">À propos</h1>
      <span class="section-title-bar" aria-hidden="true"></span>
    </div>
  </section>

  <!-- Parcours -->
  <section aria-labelledby="parcours-titre" class="py-20 px-6">
    <div class="max-w-3xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <!-- Photo -->
      <div class="aspect-[4/3] rounded-sm overflow-hidden">
        <Image
          src={photoSite}
          alt="Soin énergétique à domicile — mains posées avec douceur"
          class="w-full h-full object-cover"
          width={800}
          height={600}
        />
      </div>

      <!-- Texte -->
      <div class="flex flex-col gap-6">
        <h2 id="parcours-titre" class="font-serif text-3xl tracking-titre text-argile">
          Iris DE LEON
        </h2>
        <p class="text-argile/70 leading-lecture">
          Praticienne en soins énergétiques, je propose des accompagnements à domicile
          fondés sur l'écoute, la présence et un travail doux sur les énergies du corps.
        </p>
        <p class="text-argile/70 leading-lecture">
          Mon parcours m'a amenée à explorer différentes approches du mieux-être, pour finalement
          développer une pratique qui me ressemble : ancrée dans le réel, loin des dogmes,
          profondément humaine.
        </p>
        <p class="text-argile/70 leading-lecture">
          Je me déplace à <strong class="font-medium text-argile">Belfort et ses environs (10 km)</strong> pour que chaque personne
          puisse vivre le soin dans son propre espace de vie.
        </p>
      </div>
    </div>
  </section>

  <!-- Approche -->
  <section aria-labelledby="approche-titre" class="py-20 px-6 bg-soie">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-6">
        <h2 id="approche-titre" class="section-title">Mon approche</h2>
        <span class="section-title-bar" aria-hidden="true"></span>
      </div>
      <p class="text-center text-argile/65 leading-lecture max-w-xl mx-auto mb-12">
        Je ne travaille pas avec des protocoles. Je travaille avec vous,
        là où vous en êtes, avec ce que vous traversez au moment présent.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {[
          {
            titre: 'Vous arrivez comme vous êtes',
            texte: 'Pas de préparation, pas de bonne attitude à adopter. Je m\'adapte à vous, à votre rythme, à ce qui se présente ce jour-là.',
          },
          {
            titre: 'Pas d\'ésotérisme imposé',
            texte: 'Les énergies du corps, vous les ressentez même si vous ne croyez à rien de particulier. Je n\'ai pas besoin de vous convaincre. Votre ressenti suffit.',
          },
          {
            titre: 'Ce qui se passe ici reste ici',
            texte: 'Vos mots, vos larmes, vos silences : tout reste confidentiel. Un espace où rien ne se juge, rien ne se commente. Juste de la présence.',
          },
          {
            titre: 'L\'honnêteté comme premier soin',
            texte: 'Je ne diagnostique pas, je ne guéris pas. Ce que j\'offre : les conditions pour que quelque chose se libère. Le reste, c\'est votre corps qui le fait.',
          },
        ].map(({ titre, texte }) => (
          <div class="flex flex-col gap-3 p-6 bg-sable border border-soie/80 rounded-sm">
            <h3 class="font-serif text-lg tracking-titre text-argile">{titre}</h3>
            <p class="text-sm text-argile/70 leading-lecture">{texte}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section aria-label="Appel à l'action" class="py-16 px-6 bg-sable text-center">
    <div class="max-w-xl mx-auto flex flex-col gap-4 items-center">
      <p class="font-serif text-2xl text-argile tracking-titre">
        Envie de prendre soin de vous ?
      </p>
      <a href="/reserver" class="btn-primary">Réserver une séance</a>
    </div>
  </section>

</BaseLayout>
