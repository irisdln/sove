---
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SOVÉ — Application bien-être</title>
  <meta name="description" content="Rituels guidés, roue des émotions et journal bien-être. L'espace SOVÉ pour retrouver l'équilibre, au quotidien." />
  <style>
    :root {
      --sable: #F5F1ED;
      --soie: #EBE2D9;
      --argile: #5E4B43;
      --sauge: #A3AC9A;
      --terra: #A68A7D;
      --argile-60: rgba(94,75,67,0.60);
      --argile-30: rgba(94,75,67,0.30);
      --argile-15: rgba(94,75,67,0.12);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; touch-action: manipulation; }

    html, body {
      height: 100%;
      overscroll-behavior: none;
    }

    body {
      background: #C8BFB8;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: system-ui, -apple-system, sans-serif;
      padding: 20px;
    }

    .phone {
      width: 375px;
      height: 800px;
      background: var(--sable);
      border-radius: 44px;
      box-shadow: 0 32px 80px rgba(0,0,0,0.24), 0 2px 8px rgba(0,0,0,0.08);
      overflow: hidden;
      position: relative;
      display: flex;
      flex-direction: column;
    }

    /* STATUS BAR */
    .status {
      background: var(--sable);
      padding: 14px 28px 6px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-shrink: 0;
      z-index: 5;
    }
    .status-time { font-size: 13px; font-weight: 600; color: var(--argile); letter-spacing: 0.02em; }
    .status-icons { font-size: 11px; color: var(--argile); }

    /* SCREENS */
    .screen { flex: 1; overflow-y: auto; display: none; flex-direction: column; scrollbar-width: none; }
    .screen::-webkit-scrollbar { display: none; }
    .screen.active { display: flex; }

    /* BOTTOM NAV */
    .nav {
      background: var(--sable);
      border-top: 1px solid var(--soie);
      display: flex;
      padding: 8px 0 20px;
      flex-shrink: 0;
    }
    .nav-item {
      flex: 1; display: flex; flex-direction: column; align-items: center;
      gap: 3px; cursor: pointer; padding: 4px 0; border: none; background: none;
    }
    .nav-icon { font-size: 17px; line-height: 1; opacity: 0.35; transition: opacity 0.2s; }
    .nav-label { font-size: 8.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--argile-60); transition: color 0.2s; }
    .nav-item.active .nav-icon { opacity: 1; }
    .nav-item.active .nav-label { color: var(--sauge); font-weight: 600; }

    .serif { font-family: Georgia, serif; }
    .eyebrow { font-size: 9.5px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--sauge); }

    .btn-main {
      background: var(--argile); color: var(--sable); border: none;
      border-radius: 40px; padding: 14px 24px; font-size: 11px;
      letter-spacing: 0.14em; text-transform: uppercase; cursor: pointer;
      width: 100%; font-family: system-ui; transition: opacity 0.2s;
      text-decoration: none; display: block; text-align: center;
    }
    .btn-main:active { opacity: 0.75; }

    .btn-outline {
      background: transparent; color: var(--argile); border: 1px solid var(--argile-30);
      border-radius: 40px; padding: 12px 24px; font-size: 11px;
      letter-spacing: 0.14em; text-transform: uppercase; cursor: pointer;
      width: 100%; font-family: system-ui; text-decoration: none; display: block; text-align: center;
    }

    .btn-light {
      background: rgba(245,241,237,0.15); color: var(--sable);
      border: 1px solid rgba(245,241,237,0.25); border-radius: 40px;
      padding: 11px 20px; font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase;
      cursor: pointer; width: 100%; font-family: system-ui; text-decoration: none;
      display: block; text-align: center;
    }

    /* ONBOARDING */
    #onboarding {
      position: absolute; inset: 0; background: var(--sable);
      z-index: 20; display: flex; flex-direction: column; overflow: hidden;
    }
    .ob-slide {
      flex: 1; display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      padding: 32px 36px; text-align: center; gap: 18px;
    }
    .ob-brand { font-size: 11px; letter-spacing: 0.34em; text-transform: uppercase; color: var(--sauge); }
    .ob-circle { width: 90px; height: 90px; border-radius: 50%; border: 1px solid var(--sauge); opacity: 0.3; flex-shrink: 0; }
    .ob-title { font-family: Georgia, serif; font-size: 26px; font-weight: 400; color: var(--argile); line-height: 1.25; }
    .ob-text { font-size: 13px; color: var(--argile-60); line-height: 1.7; max-width: 260px; }
    .ob-footer { padding: 20px 36px 32px; display: flex; justify-content: center; flex-shrink: 0; }
    .ob-btn {
      background: var(--argile); color: var(--sable); border: none;
      border-radius: 40px; padding: 14px 40px; font-size: 11px;
      letter-spacing: 0.14em; text-transform: uppercase;
      cursor: pointer; font-family: system-ui; transition: opacity 0.2s;
    }
    .ob-btn:active { opacity: 0.75; }

    /* ACCUEIL */
    .home-header { padding: 18px 24px 0; }
    .home-greeting { font-size: 12px; color: var(--argile-60); margin-bottom: 2px; }
    .home-title { font-family: Georgia, serif; font-size: 24px; font-weight: 400; color: var(--argile); line-height: 1.2; }

    .affirmation-card {
      margin: 18px 24px 0; background: var(--argile); border-radius: 20px;
      padding: 22px; color: var(--sable); position: relative; overflow: hidden;
    }
    .affirmation-label { font-size: 9px; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(245,241,237,0.45); margin-bottom: 9px; }
    .affirmation-text { font-family: Georgia, serif; font-size: 17px; font-weight: 400; line-height: 1.5; }
    .affirmation-deco { position: absolute; bottom: -24px; right: -24px; width: 90px; height: 90px; border-radius: 50%; border: 1px solid rgba(163,172,154,0.2); }
    .affirmation-deco2 { position: absolute; bottom: -40px; right: -40px; width: 110px; height: 110px; border-radius: 50%; border: 1px solid rgba(163,172,154,0.1); }

    .ritual-today { margin: 16px 24px 0; }
    .ritual-today-card {
      background: var(--soie); border-radius: 16px; padding: 16px 18px;
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      cursor: pointer; margin-top: 10px; -webkit-user-select: none; user-select: none;
    }
    .ritual-today-card:active { opacity: 0.8; }
    .ritual-today-name { font-family: Georgia, serif; font-size: 15px; color: var(--argile); margin-bottom: 3px; }
    .ritual-today-meta { font-size: 10px; color: var(--argile-60); }
    .ritual-arrow { width: 34px; height: 34px; border-radius: 50%; background: var(--sable); display: flex; align-items: center; justify-content: center; font-size: 13px; color: var(--argile); flex-shrink: 0; }

    .quick-actions { padding: 14px 24px 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .quick-card { background: var(--soie); border-radius: 14px; padding: 14px; cursor: pointer; -webkit-user-select: none; user-select: none; }
    .quick-card:active { opacity: 0.7; }
    .quick-icon { font-size: 19px; margin-bottom: 8px; }
    .quick-name { font-size: 12px; color: var(--argile); font-weight: 500; margin-bottom: 2px; }
    .quick-desc { font-size: 10px; color: var(--argile-60); line-height: 1.4; }

    .ebook-banner {
      margin: 14px 24px 24px; background: var(--soie); border-radius: 14px;
      padding: 13px 16px; display: flex; align-items: center; gap: 12px;
      border-left: 3px solid var(--sauge); text-decoration: none; cursor: pointer;
    }
    .ebook-banner:active { opacity: 0.8; }
    .ebook-icon { font-size: 21px; flex-shrink: 0; }
    .ebook-label { font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--sauge); margin-bottom: 3px; }
    .ebook-title { font-size: 12px; color: var(--argile); line-height: 1.35; font-family: Georgia, serif; }
    .ebook-arrow { font-size: 12px; color: var(--argile-60); flex-shrink: 0; margin-left: auto; }

    /* RITUELS */
    .ritual-list { display: flex; flex-direction: column; gap: 9px; }
    .ritual-item {
      background: var(--soie); border-radius: 14px; padding: 15px 18px;
      display: flex; align-items: center; gap: 14px; cursor: pointer; -webkit-user-select: none; user-select: none;
    }
    .ritual-item:active { opacity: 0.7; }
    .ritual-num { font-size: 10px; color: var(--sauge); letter-spacing: 0.08em; flex-shrink: 0; width: 18px; }
    .ritual-name { font-family: Georgia, serif; font-size: 14px; color: var(--argile); margin-bottom: 2px; }
    .ritual-desc-small { font-size: 10px; color: var(--argile-60); }
    .ritual-dur { font-size: 10px; color: var(--terra); flex-shrink: 0; }

    /* TIMER */
    .timer-modal {
      display: none; position: absolute; inset: 0;
      background: var(--sable); z-index: 10; flex-direction: column; padding: 20px 24px 28px;
    }
    .timer-modal.open { display: flex; }
    .timer-back { font-size: 11px; letter-spacing: 0.1em; color: var(--sauge); text-transform: uppercase; cursor: pointer; margin-bottom: 20px; background: none; border: none; font-family: system-ui; text-align: left; padding: 0; }
    .timer-name { font-family: Georgia, serif; font-size: 22px; color: var(--argile); margin-bottom: 3px; margin-top: 4px; }
    .timer-dur { font-size: 10px; color: var(--terra); letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 20px; }
    .timer-step { background: var(--soie); border-radius: 14px; padding: 18px; flex: 1; display: flex; flex-direction: column; justify-content: center; margin-bottom: 18px; }
    .timer-step-num { font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--sauge); margin-bottom: 10px; }
    .timer-step-text { font-size: 14px; line-height: 1.75; color: var(--argile); }
    .timer-count { font-family: Georgia, serif; font-size: 46px; color: var(--argile); text-align: center; margin-bottom: 18px; }
    .timer-controls { display: flex; gap: 10px; }

    /* ÉMOTIONS */
    .emotions-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .emotion-btn {
      background: var(--soie); border: 2px solid transparent; border-radius: 14px;
      padding: 14px 8px; text-align: center; cursor: pointer; transition: all 0.2s; font-family: system-ui;
    }
    .emotion-btn.selected { border-color: var(--sauge); background: var(--sable); }
    .emotion-emoji { font-size: 22px; display: block; margin-bottom: 5px; }
    .emotion-name { font-size: 10px; color: var(--argile); }
    .emotion-result { background: var(--argile); border-radius: 16px; padding: 20px; display: none; }
    .emotion-result.show { display: block; }
    .emotion-result-label { font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(245,241,237,0.45); margin-bottom: 8px; }
    .emotion-result-title { font-family: Georgia, serif; font-size: 17px; color: var(--sable); margin-bottom: 8px; }
    .emotion-result-text { font-size: 11.5px; color: rgba(245,241,237,0.72); line-height: 1.65; margin-bottom: 16px; }

    /* JOURNAL */
    .mood-week { display: flex; justify-content: space-between; gap: 4px; margin-bottom: 18px; }
    .mood-day { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 5px; }
    .mood-day-label { font-size: 8.5px; color: var(--argile-60); letter-spacing: 0.04em; text-transform: uppercase; }
    .mood-day-dot { width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 14px; }
    .mood-day-dot.empty { background: var(--soie); }
    .mood-day-dot.today { box-shadow: 0 0 0 2px var(--argile); }

    .journal-textarea {
      width: 100%; background: var(--soie); border: none; border-radius: 14px;
      padding: 14px 16px; font-size: 13px; color: var(--argile); line-height: 1.65;
      resize: none; height: 100px; font-family: Georgia, serif; outline: none;
    }
    .journal-textarea::placeholder { color: var(--argile-60); font-style: italic; }

    .history-item { background: var(--soie); border-radius: 12px; padding: 13px 16px; display: flex; align-items: flex-start; gap: 12px; }
    .history-mood { font-size: 18px; margin-top: 1px; }
    .history-date { font-size: 10px; color: var(--argile-60); margin-bottom: 3px; }
    .history-text { font-size: 12px; color: var(--argile); line-height: 1.45; }

    /* MOI */
    .profile-header { background: var(--soie); padding: 28px 24px 24px; display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center; }
    .profile-avatar { width: 76px; height: 76px; border-radius: 50%; background: var(--sable); display: flex; align-items: center; justify-content: center; font-family: Georgia, serif; font-size: 22px; color: var(--terra); box-shadow: 0 2px 12px rgba(94,75,67,0.12); }
    .profile-name { font-family: Georgia, serif; font-size: 20px; color: var(--argile); font-weight: 400; }
    .profile-role { font-size: 11px; color: var(--argile-60); line-height: 1.5; }
    .profile-bio { font-size: 12.5px; color: var(--argile-60); line-height: 1.75; }

    .link-row {
      background: var(--soie); border-radius: 12px; padding: 14px 16px;
      display: flex; align-items: center; gap: 12px; text-decoration: none; cursor: pointer;
    }
    .link-row:active { opacity: 0.7; }
    .link-row + .link-row { margin-top: 8px; }
    .link-row-icon { font-size: 18px; width: 36px; height: 36px; background: var(--sable); border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .link-row-text { flex: 1; }
    .link-row-name { font-size: 13px; color: var(--argile); font-weight: 500; }
    .link-row-desc { font-size: 10px; color: var(--argile-60); margin-top: 1px; }
    .link-row-arrow { font-size: 12px; color: var(--argile-60); }

    @media (max-width: 420px) {
      body { padding: 0; background: var(--sable); align-items: stretch; }
      .phone { width: 100%; height: 100dvh; border-radius: 0; box-shadow: none; }
    }
  </style>
</head>
<body>

<div class="phone">

  <div class="status">
    <span class="status-time" id="clock">9:41</span>
    <span class="status-icons">●●● 100%</span>
  </div>

  <!-- ONBOARDING -->
  <div id="onboarding">
    <div class="ob-slide">
      <span class="ob-brand">SOVÉ</span>
      <div class="ob-circle"></div>
      <h1 class="ob-title serif">Bienvenue dans votre espace bien-être</h1>
      <p class="ob-text">Des rituels simples pour libérer ce qui pèse et retrouver l'équilibre, au quotidien.</p>
    </div>
    <div class="ob-footer">
      <button class="ob-btn" onclick="document.getElementById('onboarding').style.display='none'">Commencer</button>
    </div>
  </div>

  <!-- ACCUEIL -->
  <div class="screen active" id="s-home">
    <div class="home-header">
      <p class="home-greeting">Bonjour,</p>
      <h1 class="home-title serif">Comment vous<br>sentez-vous ?</h1>
    </div>

    <div class="affirmation-card">
      <p class="affirmation-label">Affirmation du jour</p>
      <p class="affirmation-text serif">"Je m'autorise à poser ce que je porte. Je suis en sécurité."</p>
      <div class="affirmation-deco"></div>
      <div class="affirmation-deco2"></div>
    </div>

    <div class="ritual-today" style="margin-bottom:0">
      <p class="eyebrow">Rituel du jour</p>
      <div class="ritual-today-card" onclick="openTimer(0)">
        <div>
          <p class="ritual-today-name serif">La respiration libératrice</p>
          <p class="ritual-today-meta">5 minutes · Pour déposer la tension</p>
        </div>
        <div class="ritual-arrow">→</div>
      </div>
    </div>

    <div class="quick-actions">
      <div class="quick-card" onclick="switchScreen('s-emotions')">
        <div class="quick-icon">🌀</div>
        <p class="quick-name">Mes émotions</p>
        <p class="quick-desc">Trouver le rituel adapté</p>
      </div>
      <div class="quick-card" onclick="switchScreen('s-journal')">
        <div class="quick-icon">📓</div>
        <p class="quick-name">Mon journal</p>
        <p class="quick-desc">Noter ce que je ressens</p>
      </div>
    </div>

    <a class="ebook-banner" href="https://irisdln.gumroad.com/l/guide-bien-etre" target="_blank" rel="noopener noreferrer">
      <span class="ebook-icon">📖</span>
      <div style="flex:1">
        <p class="ebook-label">Guide SOVÉ</p>
        <p class="ebook-title">5 rituels pour libérer ce qui pèse</p>
      </div>
      <span class="ebook-arrow">→</span>
    </a>
  </div>

  <!-- RITUELS -->
  <div class="screen" id="s-rituels">
    <div style="padding:20px 24px 24px;display:flex;flex-direction:column;gap:16px">
      <div>
        <p class="eyebrow">Les 5 rituels</p>
        <h2 class="serif" style="font-size:20px;font-weight:400;color:var(--argile);line-height:1.2;margin-top:4px">Choisissez votre moment</h2>
      </div>
      <div class="ritual-list">
        <div class="ritual-item" onclick="openTimer(0)">
          <span class="ritual-num">01</span>
          <div style="flex:1"><p class="ritual-name">La respiration libératrice</p><p class="ritual-desc-small">Déposer la tension</p></div>
          <span class="ritual-dur">5 min</span>
        </div>
        <div class="ritual-item" onclick="openTimer(1)">
          <span class="ritual-num">02</span>
          <div style="flex:1"><p class="ritual-name">L'ancrage dans le corps</p><p class="ritual-desc-small">Revenir à soi</p></div>
          <span class="ritual-dur">10 min</span>
        </div>
        <div class="ritual-item" onclick="openTimer(2)">
          <span class="ritual-num">03</span>
          <div style="flex:1"><p class="ritual-name">L'écriture émotionnelle</p><p class="ritual-desc-small">Mettre des mots sur ce qui déborde</p></div>
          <span class="ritual-dur">15 min</span>
        </div>
        <div class="ritual-item" onclick="openTimer(3)">
          <span class="ritual-num">04</span>
          <div style="flex:1"><p class="ritual-name">Le bain de lumière</p><p class="ritual-desc-small">Visualisation guidée</p></div>
          <span class="ritual-dur">10 min</span>
        </div>
        <div class="ritual-item" onclick="openTimer(4)">
          <span class="ritual-num">05</span>
          <div style="flex:1"><p class="ritual-name">Le rituel du soir</p><p class="ritual-desc-small">Poser la journée</p></div>
          <span class="ritual-dur">10 min</span>
        </div>
      </div>
    </div>

    <div class="timer-modal" id="timer-modal">
      <button class="timer-back" onclick="closeTimer()">← Retour</button>
      <p class="eyebrow" id="t-eyebrow"></p>
      <h2 class="timer-name" id="t-name"></h2>
      <p class="timer-dur" id="t-dur"></p>
      <div class="timer-step">
        <p class="timer-step-num" id="t-step-num"></p>
        <p class="timer-step-text" id="t-step-text"></p>
      </div>
      <p class="timer-count" id="t-count">5:00</p>
      <div class="timer-controls">
        <button class="btn-outline" id="t-prev" onclick="prevStep()" style="flex:1">← Précédent</button>
        <button class="btn-main" id="t-next" onclick="nextStep()" style="flex:2">Étape suivante →</button>
      </div>
    </div>
  </div>

  <!-- ÉMOTIONS -->
  <div class="screen" id="s-emotions">
    <div style="padding:20px 24px 24px;display:flex;flex-direction:column;gap:16px">
      <div>
        <p class="eyebrow">Mes émotions</p>
        <h2 class="serif" style="font-size:20px;font-weight:400;color:var(--argile);line-height:1.3;margin-top:4px">Comment je me sens<br>en ce moment ?</h2>
      </div>
      <div class="emotions-grid">
        <button class="emotion-btn" onclick="selectEmotion(this,'La respiration libératrice','Quand la tension monte, revenez à votre souffle. Ce rituel de 5 minutes vous aide à déposer la pression immédiatement.')">
          <span class="emotion-emoji">😰</span><span class="emotion-name">Stressée</span>
        </button>
        <button class="emotion-btn" onclick="selectEmotion(this,'Le bain de lumière','Votre corps a besoin de se ressourcer. Cette visualisation guidée vous aide à retrouver de l\'énergie en douceur.')">
          <span class="emotion-emoji">😴</span><span class="emotion-name">Fatiguée</span>
        </button>
        <button class="emotion-btn" onclick="selectEmotion(this,'L\'écriture émotionnelle','Laissez sortir ce qui pèse. Mettre des mots sur la tristesse permet de la traverser plutôt que de la porter.')">
          <span class="emotion-emoji">🥺</span><span class="emotion-name">Triste</span>
        </button>
        <button class="emotion-btn" onclick="selectEmotion(this,'L\'ancrage dans le corps','Quand le mental s\'emballe, revenez dans votre corps. Ce rituel vous aide à retrouver un point fixe en vous.')">
          <span class="emotion-emoji">🌀</span><span class="emotion-name">Dispersée</span>
        </button>
        <button class="emotion-btn" onclick="selectEmotion(this,'Le rituel du soir','Posez la colère avant qu\'elle ne s\'installe. Ce rituel vous aide à déposer la journée et à retrouver la paix.')">
          <span class="emotion-emoji">😤</span><span class="emotion-name">En colère</span>
        </button>
        <button class="emotion-btn" onclick="selectEmotion(this,'Le rituel du soir','Vous vous sentez bien — c\'est le bon moment pour ancrer cet état et préparer une belle nuit de repos.')">
          <span class="emotion-emoji">🌸</span><span class="emotion-name">Bien</span>
        </button>
      </div>
      <div class="emotion-result" id="emotion-result">
        <p class="emotion-result-label">Rituel recommandé</p>
        <h3 class="emotion-result-title serif" id="emotion-ritual-name"></h3>
        <p class="emotion-result-text" id="emotion-ritual-text"></p>
        <button class="btn-light" onclick="switchScreen('s-rituels')">Commencer ce rituel</button>
      </div>
    </div>
  </div>

  <!-- JOURNAL -->
  <div class="screen" id="s-journal">
    <div style="padding:20px 24px 24px;display:flex;flex-direction:column;gap:16px">
      <div>
        <p class="eyebrow">Mon journal</p>
        <h2 class="serif" style="font-size:20px;font-weight:400;color:var(--argile);line-height:1.3;margin-top:4px">Ma semaine</h2>
      </div>

      <div style="background:var(--soie);border-radius:16px;padding:16px 14px">
        <div class="mood-week">
          <div class="mood-day"><span class="mood-day-label">L</span><div class="mood-day-dot" style="background:#C9BDB1">🙂</div></div>
          <div class="mood-day"><span class="mood-day-label">M</span><div class="mood-day-dot" style="background:#EBE2D9">😐</div></div>
          <div class="mood-day"><span class="mood-day-label">M</span><div class="mood-day-dot" style="background:#EBE2D9">😐</div></div>
          <div class="mood-day"><span class="mood-day-label">J</span><div class="mood-day-dot" style="background:#A3AC9A">😊</div></div>
          <div class="mood-day"><span class="mood-day-label">V</span><div class="mood-day-dot" style="background:#C9BDB1">🙂</div></div>
          <div class="mood-day"><span class="mood-day-label">S</span><div class="mood-day-dot empty today"></div></div>
          <div class="mood-day"><span class="mood-day-label">D</span><div class="mood-day-dot empty"></div></div>
        </div>
        <p style="font-size:10px;color:var(--argile-60);text-align:center;margin-top:4px">5 jours consécutifs ✦</p>
      </div>

      <div>
        <p class="eyebrow" style="margin-bottom:10px">Aujourd'hui</p>
        <div style="display:flex;justify-content:space-between;gap:6px;margin-bottom:10px">
          <div class="mood-day-dot empty" style="width:42px;height:42px;font-size:20px;cursor:pointer;background:var(--soie)" onclick="selectMood(this)">😔</div>
          <div class="mood-day-dot empty" style="width:42px;height:42px;font-size:20px;cursor:pointer;background:var(--soie)" onclick="selectMood(this)">😕</div>
          <div class="mood-day-dot empty" style="width:42px;height:42px;font-size:20px;cursor:pointer;background:var(--soie)" onclick="selectMood(this)">😐</div>
          <div class="mood-day-dot empty" style="width:42px;height:42px;font-size:20px;cursor:pointer;background:var(--soie)" onclick="selectMood(this)">🙂</div>
          <div class="mood-day-dot empty" style="width:42px;height:42px;font-size:20px;cursor:pointer;background:var(--soie)" onclick="selectMood(this)">😊</div>
        </div>
        <textarea class="journal-textarea" placeholder="Ce que je porte en ce moment…"></textarea>
        <button class="btn-main" style="margin-top:10px" onclick="saveEntry()">Enregistrer</button>
      </div>

      <div>
        <p class="eyebrow" style="margin-bottom:10px">Entrées récentes</p>
        <div style="display:flex;flex-direction:column;gap:8px">
          <div class="history-item"><span class="history-mood">🙂</span><div><p class="history-date">Hier · 21h14</p><p class="history-text">Journée chargée mais je me sens plus légère après le rituel.</p></div></div>
          <div class="history-item"><span class="history-mood">😐</span><div><p class="history-date">Lundi · 8h03</p><p class="history-text">Beaucoup de pensées ce matin. L'ancrage m'a aidée.</p></div></div>
          <div class="history-item"><span class="history-mood">😊</span><div><p class="history-date">Jeudi · 19h40</p><p class="history-text">Belle journée. J'ai fait le bain de lumière — je recommande vraiment.</p></div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- MOI -->
  <div class="screen" id="s-moi">
    <div class="profile-header">
      <div class="profile-avatar">I</div>
      <div>
        <p class="profile-name">Iris DE LEON</p>
        <p class="profile-role">Praticienne en soins énergétiques<br>Belfort &amp; alentours · À domicile</p>
      </div>
    </div>
    <div style="padding:20px 24px 24px;display:flex;flex-direction:column;gap:20px">
      <p class="profile-bio">Je pratique des soins énergétiques à domicile pour vous aider à libérer les tensions, retrouver votre équilibre et vous recentrer. Cette application est un prolongement de ce travail — pour que vous puissiez continuer à prendre soin de vous, même entre deux séances.</p>
      <div>
        <p style="font-size:9.5px;letter-spacing:0.22em;text-transform:uppercase;color:var(--sauge);margin-bottom:10px">Aller plus loin</p>
        <a class="link-row" href="/reserver" target="_blank" rel="noopener noreferrer">
          <div class="link-row-icon">🌿</div>
          <div class="link-row-text"><p class="link-row-name">Réserver une séance</p><p class="link-row-desc">Soin énergétique à domicile</p></div>
          <span class="link-row-arrow">→</span>
        </a>
        <a class="link-row" href="https://irisdln.gumroad.com/l/guide-bien-etre" target="_blank" rel="noopener noreferrer">
          <div class="link-row-icon">📖</div>
          <div class="link-row-text"><p class="link-row-name">Le guide bien-être</p><p class="link-row-desc">PDF · 13,20 € TTC</p></div>
          <span class="link-row-arrow">→</span>
        </a>
        <a class="link-row" href="/" target="_blank" rel="noopener noreferrer">
          <div class="link-row-icon">🌐</div>
          <div class="link-row-text"><p class="link-row-name">Site web SOVÉ</p><p class="link-row-desc">sove-soins.vercel.app</p></div>
          <span class="link-row-arrow">→</span>
        </a>
      </div>
      <p style="font-size:10px;color:var(--argile-60);text-align:center;line-height:1.6;padding-bottom:8px">Les soins proposés ne sont pas des actes médicaux et ne se substituent pas à un suivi médical.</p>
    </div>
  </div>

  <!-- NAV -->
  <nav class="nav">
    <button class="nav-item active" onclick="switchScreen('s-home')" id="nav-home">
      <span class="nav-icon">🏠</span><span class="nav-label">Accueil</span>
    </button>
    <button class="nav-item" onclick="switchScreen('s-rituels')" id="nav-rituels">
      <span class="nav-icon">✨</span><span class="nav-label">Rituels</span>
    </button>
    <button class="nav-item" onclick="switchScreen('s-emotions')" id="nav-emotions">
      <span class="nav-icon">🌀</span><span class="nav-label">Émotions</span>
    </button>
    <button class="nav-item" onclick="switchScreen('s-journal')" id="nav-journal">
      <span class="nav-icon">📓</span><span class="nav-label">Journal</span>
    </button>
    <button class="nav-item" onclick="switchScreen('s-moi')" id="nav-moi">
      <span class="nav-icon">👤</span><span class="nav-label">Moi</span>
    </button>
  </nav>
</div>

<script is:inline>
  // Horloge réelle
  function updateClock() {
    const now = new Date();
    const h = now.getHours().toString().padStart(2,'0');
    const m = now.getMinutes().toString().padStart(2,'0');
    document.getElementById('clock').textContent = h + ':' + m;
  }
  updateClock();
  setInterval(updateClock, 10000);

  // Nav
  const screenNav = { 's-home':'nav-home', 's-rituels':'nav-rituels', 's-emotions':'nav-emotions', 's-journal':'nav-journal', 's-moi':'nav-moi' };
  function switchScreen(id) {
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    document.getElementById(id).classList.add('active');
    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    if (screenNav[id]) document.getElementById(screenNav[id]).classList.add('active');
    closeTimer();
  }

  // Timer
  const rituels = [
    { name:'La respiration libératrice', dur:'5 minutes', num:'Rituel 01', steps:[
      'Installez-vous confortablement, assise ou allongée. Fermez les yeux si c\'est possible.',
      'Inspirez lentement par le nez en comptant jusqu\'à 4. Laissez votre ventre s\'ouvrir.',
      'Retenez doucement 2 secondes. Juste une pause, sans effort.',
      'Expirez lentement par la bouche jusqu\'à 6. Laissez partir ce qui pèse.',
      'Répétez 5 fois. À chaque expiration, imaginez que vous posez quelque chose.'
    ]},
    { name:'L\'ancrage dans le corps', dur:'10 minutes', num:'Rituel 02', steps:[
      'Posez vos deux pieds à plat sur le sol. Sentez le contact et la pression.',
      'Nommez 5 choses que vous voyez, 4 que vous touchez, 3 sons que vous entendez.',
      'Posez une main sur le ventre, l\'autre sur le cœur. Sentez votre respiration.',
      'Imaginez des racines qui partent de vos pieds et s\'enfoncent dans la terre.',
      'Restez dans cette sensation. Quand une pensée arrive, laissez-la passer.'
    ]},
    { name:'L\'écriture émotionnelle', dur:'15 minutes', num:'Rituel 03', steps:[
      'Prenez un carnet et un stylo. Installez-vous dans un endroit calme.',
      'Écrivez en haut de la page : "Qu\'est-ce que je porte en ce moment ?"',
      'Écrivez sans vous arrêter pendant 10 minutes. Ne relisez pas.',
      'Quand le temps est écoulé, fermez le carnet. Vous n\'avez pas à relire.'
    ]},
    { name:'Le bain de lumière', dur:'10 minutes', num:'Rituel 04', steps:[
      'Allongez-vous confortablement. Fermez les yeux. Prenez 3 respirations.',
      'Imaginez une lumière chaude et dorée qui entre par le sommet de votre tête.',
      'Laissez cette lumière descendre : tête, épaules, poitrine, ventre, jambes.',
      'Partout où elle passe, imaginez qu\'elle dissout ce qui est lourd ou coincé.',
      'Restez baignée dans cette lumière. Ouvrez doucement les yeux quand vous êtes prête.'
    ]},
    { name:'Le rituel du soir', dur:'10 minutes', num:'Rituel 05', steps:[
      'Avant de vous coucher, asseyez-vous quelques instants. Éteignez les écrans.',
      'Posez mentalement la journée : qu\'est-ce qui s\'est passé ? Qu\'avez-vous ressenti ?',
      'Identifiez une chose, même petite, pour laquelle vous êtes reconnaissante.',
      'Imaginez que vous posez la journée dans une boîte. Vous la fermez.',
      'Prenez 5 respirations. Dites-vous : "J\'ai fait ce que j\'ai pu. C\'est suffisant."'
    ]}
  ];

  let curRituel = 0, curStep = 0;

  function openTimer(idx) {
    curRituel = idx; curStep = 0;
    const r = rituels[idx];
    document.getElementById('t-eyebrow').textContent = r.num;
    document.getElementById('t-name').textContent = r.name;
    document.getElementById('t-dur').textContent = r.dur;
    updateStep();
    document.getElementById('timer-modal').classList.add('open');
    switchScreen('s-rituels');
  }

  function closeTimer() { document.getElementById('timer-modal').classList.remove('open'); }

  function updateStep() {
    const r = rituels[curRituel];
    document.getElementById('t-step-num').textContent = `Étape ${curStep + 1} / ${r.steps.length}`;
    document.getElementById('t-step-text').textContent = r.steps[curStep];
    document.getElementById('t-prev').style.display = curStep === 0 ? 'none' : 'block';
    document.getElementById('t-next').textContent = curStep === r.steps.length - 1 ? 'Terminer ✓' : 'Étape suivante →';
  }

  function nextStep() {
    if (curStep < rituels[curRituel].steps.length - 1) { curStep++; updateStep(); } else { closeTimer(); }
  }

  function prevStep() { if (curStep > 0) { curStep--; updateStep(); } }

  // Émotions
  function selectEmotion(btn, ritual, text) {
    document.querySelectorAll('.emotion-btn').forEach(b => b.classList.remove('selected'));
    btn.classList.add('selected');
    document.getElementById('emotion-ritual-name').textContent = ritual;
    document.getElementById('emotion-ritual-text').textContent = text;
    document.getElementById('emotion-result').classList.add('show');
  }

  // Journal
  function selectMood(el) {
    el.parentElement.querySelectorAll('.mood-day-dot').forEach(d => { d.style.boxShadow = ''; d.style.transform = ''; });
    el.style.boxShadow = '0 0 0 2px var(--argile)';
    el.style.transform = 'scale(1.15)';
  }

  function saveEntry() {
    const ta = document.querySelector('.journal-textarea');
    if (ta.value.trim()) {
      ta.value = '';
      document.querySelectorAll('#s-journal .mood-day-dot[onclick]').forEach(d => { d.style.boxShadow = ''; d.style.transform = ''; });
    }
  }
</script>

</body>
</html>
