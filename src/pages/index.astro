---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SoinCard from '@/components/SoinCard.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import logo from '@/assets/logo-sove.png';
import photoSite from '@/assets/photo_site.jpg';

const soins = (await getCollection('soins', ({ data }) => !data.draft))
  .sort((a, b) => a.data.ordre - b.data.ordre)
  .slice(0, 3);
---

<BaseLayout
  title="SOVÉ"
  description="Soins énergétiques à domicile à Belfort. Retrouvez un apaisement profond, libérez les tensions et reconnectez-vous à vous-même."
>

  <!-- Hero -->
  <section
    aria-labelledby="hero-titre"
    class="min-h-[90vh] flex flex-col items-center justify-center text-center px-6 py-24 bg-sable"
  >
    <div class="max-w-2xl mx-auto flex flex-col items-center gap-10">
      <Image
        src={logo}
        alt="SOVÉ"
        width={180}
        height={180}
        format="png"
        class="h-40 w-auto opacity-90"
        loading="eager"
      />
      <div class="flex flex-col items-center gap-6">
        <h1
          id="hero-titre"
          class="font-serif text-5xl md:text-6xl lg:text-7xl font-light tracking-titre text-argile leading-tight"
        >
          Retrouvez un<br />
          <em class="not-italic text-terracotta">apaisement profond</em>
        </h1>
        <span class="block w-10 h-px bg-sauge mx-auto"></span>
        <p class="text-base md:text-lg text-argile/65 leading-lecture max-w-lg mx-auto">
          Des soins énergétiques à domicile pour libérer les tensions,
          retrouver l'équilibre et vous reconnecter à vous-même.
          Dans votre espace, à votre rythme.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/reserver" class="btn-primary">Réserver un soin</a>
        <a href="/a-propos" class="btn-outline">Découvrir l'approche</a>
      </div>
      <p class="text-xs text-argile/40 tracking-wide">
        Déplacement à domicile · Cadre confidentiel · Sans engagement
      </p>
    </div>
  </section>

  <!-- Bienfaits concrets -->
  <section aria-labelledby="bienfaits-titre" class="bg-soie py-24 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <h2 id="bienfaits-titre" class="section-title">
        Ce que vous allez ressentir
      </h2>
      <span class="section-title-bar" aria-hidden="true"></span>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mt-8">
        {[
          {
            titre: 'Lâcher-prise',
            texte: 'Relâchez les tensions accumulées dans le corps et dans la tête. Repartez légère, ancrée dans l\'instant présent.',
          },
          {
            titre: 'Équilibre émotionnel',
            texte: 'Traversez les émotions difficiles sans les porter seule. Un espace sécurisé pour accueillir ce qui se présente.',
          },
          {
            titre: 'Reconnexion à soi',
            texte: 'Retrouvez le fil avec vous-même, avec ce qui est stable en vous. Clarté, douceur, recentrage.',
          },
        ].map(({ titre, texte }) => (
          <div class="flex flex-col items-center gap-4 text-center px-2">
            <span class="block w-6 h-px bg-sauge mx-auto"></span>
            <h3 class="font-serif text-xl tracking-titre text-argile">{titre}</h3>
            <p class="text-sm text-argile/65 leading-lecture">{texte}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Soins mis en avant -->
  {soins.length > 0 && (
    <section aria-labelledby="soins-titre" class="py-24 px-6">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-14">
          <h2 id="soins-titre" class="section-title">Le soin proposé</h2>
          <span class="section-title-bar" aria-hidden="true"></span>
          <p class="text-sm text-argile/60 mt-4 max-w-md mx-auto leading-lecture">
            Un accompagnement adapté à votre besoin du moment. Une première séance suffit pour ressentir la différence.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {soins.map((soin) => (
            <SoinCard
              titre={soin.data.titre}
              resume={soin.data.resume}
              duree={soin.data.duree}
              tarif={soin.data.tarif}
              href={`/soins/${soin.slug}`}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Témoignages -->
  <section aria-labelledby="temoignages-titre" class="bg-soie py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-14">
        <h2 id="temoignages-titre" class="section-title">Ce qu'elles en disent</h2>
        <span class="section-title-bar" aria-hidden="true"></span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <div class="flex justify-center">
          <video
            src="/avis-sandra.mp4"
            controls
            playsinline
            preload="metadata"
            class="rounded-sm w-full max-w-[280px] aspect-[9/16] object-cover"
            aria-label="Témoignage vidéo de Sandra"
          >
            Votre navigateur ne supporte pas la lecture vidéo.
          </video>
        </div>
        <div class="flex flex-col gap-6">
          <p class="text-xs tracking-cta uppercase text-sauge">Sandra</p>
          <h3 class="font-serif text-3xl tracking-titre text-argile font-light leading-snug">
            Un retour sincère,<br />après sa séance
          </h3>
          <span class="block w-8 h-px bg-sauge"></span>
          <p class="text-argile/65 leading-lecture text-sm md:text-base">
            Sandra partage son vécu librement, filmé chez elle, après son soin de libération émotionnelle.
          </p>
          <a href="/reserver" class="btn-primary self-start">Réserver ma séance</a>
        </div>
      </div>
    </div>
  </section>

  <!-- À propos — mini section -->
  <section aria-labelledby="apropos-home-titre" class="py-24 px-6">
    <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <!-- Photo -->
      <div class="aspect-[4/3] rounded-sm overflow-hidden">
        <Image
          src={photoSite}
          alt="Soin énergétique à domicile — mains posées avec douceur"
          class="w-full h-full object-cover"
          width={800}
          height={600}
        />
      </div>

      <!-- Texte -->
      <div class="flex flex-col gap-6">
        <div>
          <p class="text-xs tracking-cta uppercase text-sauge mb-3">La praticienne</p>
          <h2 id="apropos-home-titre" class="font-serif text-3xl md:text-4xl tracking-titre text-argile font-light leading-snug">
            Une approche humaine,<br />sans discours ésotérique
          </h2>
        </div>
        <span class="block w-8 h-px bg-sauge"></span>
        <p class="text-argile/65 leading-lecture text-sm md:text-base">
          Je suis Iris, praticienne en soins énergétiques.
          Mon travail est fondé sur l'écoute, la présence et un accompagnement doux
          qui va là où c'est nécessaire. Sans métaphysique imposée, sans promesses.
        </p>
        <p class="text-argile/65 leading-lecture text-sm md:text-base">
          Ce qui m'importe : que vous repartiez plus légère, plus ancrée,
          avec un peu plus d'espace intérieur qu'à votre arrivée.
        </p>
        <a href="/a-propos" class="btn-outline self-start mt-2">Mon parcours</a>
      </div>
    </div>
  </section>

  <!-- À domicile -->
  <section aria-labelledby="domicile-titre" class="bg-soie py-24 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-xs tracking-cta uppercase text-sauge mb-4">Comment ça fonctionne</p>
      <h2 id="domicile-titre" class="section-title">Un soin chez vous,<br />à votre rythme</h2>
      <span class="section-title-bar" aria-hidden="true"></span>
      <p class="text-argile/65 leading-lecture mb-10 max-w-xl mx-auto">
        Je me déplace avec tout le matériel nécessaire. Vous restez dans votre espace,
        sans stress du retour, sans rupture de l'état de détente.
        Après le soin, vous êtes déjà chez vous. C'est là que la récupération commence.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/reserver" class="btn-primary">Prendre rendez-vous</a>
        <a href="/tarifs" class="btn-outline">Voir les tarifs</a>
      </div>
    </div>
  </section>

  <!-- Citation finale -->
  <section aria-label="Citation" class="py-24 px-6">
    <div class="max-w-2xl mx-auto text-center">
      <blockquote class="font-serif text-2xl md:text-3xl font-light italic text-argile/70 leading-relaxed tracking-titre">
        "Se déposer, enfin."
      </blockquote>
    </div>
  </section>

</BaseLayout>
