---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SoinCard from '@/components/SoinCard.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import logo from '@/assets/logo-sove.png';

const soins = (await getCollection('soins', ({ data }) => !data.draft))
  .sort((a, b) => a.data.ordre - b.data.ordre)
  .slice(0, 3);
---

<BaseLayout
  title="SOVÉ"
  description="Soins énergétiques à domicile — Ancrage, Profondeur & Sécurité. Accompagnement holistique personnalisé pour retrouver équilibre et mieux-être."
>

  <!-- Hero -->
  <section
    aria-labelledby="hero-titre"
    class="min-h-[80vh] flex flex-col items-center justify-center text-center px-6 py-24 bg-sable"
  >
    <div class="max-w-xl mx-auto flex flex-col items-center gap-8">
      <Image
        src={logo}
        alt="SOVÉ"
        width={120}
        height={120}
        class="h-28 w-auto opacity-90 mix-blend-multiply"
        loading="eager"
      />
      <div>
        <h1
          id="hero-titre"
          class="font-serif text-5xl md:text-6xl font-light tracking-titre text-argile"
        >
          Soins énergétiques<br />
          <em class="not-italic text-terracotta">à domicile</em>
        </h1>
        <span class="block w-10 h-px bg-sauge mx-auto mt-6 mb-6"></span>
        <p class="text-base md:text-lg text-argile/70 leading-lecture max-w-md mx-auto">
          Un espace de relâchement profond, directement chez vous.
          Ancrage, Profondeur &amp; Sécurité.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="btn-primary">Réserver un soin</a>
        <a href="/a-propos" class="btn-outline">Découvrir l'approche</a>
      </div>
    </div>
  </section>

  <!-- Valeurs -->
  <section aria-labelledby="valeurs-titre" class="bg-soie py-20 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <h2 id="valeurs-titre" class="section-title">
        Une présence, un espace
      </h2>
      <span class="section-title-bar" aria-hidden="true"></span>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mt-6">
        {[
          {
            icon: '◦',
            titre: 'Ancrage',
            texte: 'Revenir à soi, au corps, au souffle. Se relier à ce qui est stable en vous.',
          },
          {
            icon: '◦',
            titre: 'Profondeur',
            texte: 'Un accompagnement qui ne reste pas en surface. Doux, mais qui va là où c\'est nécessaire.',
          },
          {
            icon: '◦',
            titre: 'Sécurité',
            texte: 'Un cadre bienveillant, confidentiel, entièrement pensé pour votre confort.',
          },
        ].map(({ icon, titre, texte }) => (
          <div class="flex flex-col items-center gap-3 text-center">
            <span class="text-sauge text-2xl" aria-hidden="true">{icon}</span>
            <h3 class="font-serif text-xl tracking-titre text-argile">{titre}</h3>
            <p class="text-sm text-argile/70 leading-lecture">{texte}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Soins mis en avant -->
  {soins.length > 0 && (
    <section aria-labelledby="soins-titre" class="py-20 px-6">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 id="soins-titre" class="section-title">Les soins proposés</h2>
          <span class="section-title-bar" aria-hidden="true"></span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {soins.map((soin) => (
            <SoinCard
              titre={soin.data.titre}
              resume={soin.data.resume}
              duree={soin.data.duree}
              tarif={soin.data.tarif}
              href={`/soins/${soin.slug}`}
            />
          ))}
        </div>

        <div class="text-center mt-10">
          <a href="/soins" class="btn-outline">Voir tous les soins</a>
        </div>
      </div>
    </section>
  )}

  <!-- À domicile -->
  <section aria-labelledby="domicile-titre" class="bg-soie py-20 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <h2 id="domicile-titre" class="section-title">À votre domicile</h2>
      <span class="section-title-bar" aria-hidden="true"></span>
      <p class="text-argile/70 leading-lecture mb-8">
        Je me déplace chez vous pour que vous puissiez profiter du soin dans votre propre espace,
        sans le trajet du retour, sans la rupture de l'état de détente.
        C'est cette continuité qui fait toute la différence.
      </p>
      <a href="/contact" class="btn-primary">Prendre rendez-vous</a>
    </div>
  </section>

  <!-- Citation -->
  <section aria-label="Citation" class="py-20 px-6">
    <div class="max-w-2xl mx-auto text-center">
      <blockquote class="font-serif text-2xl md:text-3xl font-light italic text-argile/80 leading-relaxed tracking-titre">
        "Se déposer, enfin."
      </blockquote>
    </div>
  </section>

</BaseLayout>
