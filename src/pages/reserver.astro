---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Réserver un soin"
  description="Choisissez votre créneau en ligne pour un soin de libération émotionnelle à domicile avec SOVÉ."
>

  <!-- Hero réservation -->
  <section aria-labelledby="reserver-titre" class="min-h-[70vh] flex flex-col items-center justify-center text-center px-6 py-24 bg-sable">
    <div class="max-w-xl mx-auto flex flex-col items-center gap-10">
      <div class="flex flex-col items-center gap-6">
        <p class="text-xs tracking-cta uppercase text-sauge">Prise de rendez-vous</p>
        <h1 id="reserver-titre" class="font-serif text-4xl md:text-5xl font-light tracking-titre text-argile leading-snug">
          Choisissez votre créneau
        </h1>
        <span class="block w-10 h-px bg-sauge mx-auto"></span>
        <p class="text-base text-argile/65 leading-lecture max-w-md">
          Sélectionnez directement le jour et l'heure qui vous conviennent.
          Je me déplace chez vous — confirmez en quelques secondes.
        </p>
      </div>

      <a
        href="https://calendly.com/soins-sove"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary text-sm px-10 py-4"
      >
        Choisir mon créneau
      </a>

      <p class="text-xs text-argile/40 tracking-wide">
        Vous serez redirigé·e vers notre calendrier de réservation sécurisé
      </p>
    </div>
  </section>

  <!-- Infos pratiques -->
  <section aria-label="Informations pratiques" class="py-20 px-6 bg-soie">
    <div class="max-w-3xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-10 text-center">
      {[
        { titre: 'Durée', detail: '45 min – 1h' },
        { titre: 'Tarif', detail: '60 €' },
        { titre: 'Lieu', detail: 'À votre domicile' },
      ].map(({ titre, detail }) => (
        <div class="flex flex-col gap-3">
          <span class="block w-6 h-px bg-sauge mx-auto"></span>
          <p class="text-xs tracking-cta uppercase text-argile/50">{titre}</p>
          <p class="font-serif text-2xl text-argile">{detail}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Rassurant -->
  <section aria-label="Informations complémentaires" class="py-20 px-6">
    <div class="max-w-3xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8">
      {[
        {
          titre: 'Comment ça se passe ?',
          texte: 'Après votre réservation, je vous contacte par mail pour confirmer l\'adresse et vous préparer à la séance. Pas de surprise.',
        },
        {
          titre: 'Une question avant ?',
          texte: 'Pas d\'hésitation à me contacter d\'abord. Un échange par message suffit pour vérifier que le soin correspond à ce dont vous avez besoin.',
          lien: '/contact',
          labelLien: 'Envoyer un message',
        },
      ].map(({ titre, texte, lien, labelLien }) => (
        <div class="flex flex-col gap-4 p-8 bg-soie border border-soie/80 rounded-sm">
          <h2 class="font-serif text-lg tracking-titre text-argile">{titre}</h2>
          <p class="text-sm text-argile/65 leading-lecture">{texte}</p>
          {lien && (
            <a href={lien} class="text-xs tracking-cta uppercase text-sauge hover:text-argile transition-colors duration-200">
              {labelLien} →
            </a>
          )}
        </div>
      ))}
    </div>
  </section>

</BaseLayout>
