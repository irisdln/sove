---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Réserver un soin"
  description="Choisissez votre créneau en ligne pour un soin de libération émotionnelle à domicile avec SOVÉ."
>

  <!-- En-tête -->
  <section aria-labelledby="reserver-titre" class="py-20 px-6 text-center bg-soie">
    <div class="max-w-2xl mx-auto">
      <h1 id="reserver-titre" class="section-title">Prendre rendez-vous</h1>
      <span class="section-title-bar" aria-hidden="true"></span>
      <p class="text-argile/70 leading-lecture">
        Choisissez directement le créneau qui vous convient.
        Je vous confirme la réservation et vous envoie tous les détails par mail.
      </p>
    </div>
  </section>

  <!-- Calendly embed -->
  <section aria-label="Calendrier de réservation" class="py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <!-- Remplacer l'URL par votre lien Calendly -->
      <div
        class="calendly-inline-widget"
        data-url="https://calendly.com/soins-sove"
        style="min-width:320px;height:700px;"
      ></div>
      <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
    </div>
  </section>

  <!-- Infos pratiques -->
  <section aria-label="Informations pratiques" class="py-16 px-6 bg-soie">
    <div class="max-w-3xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-10 text-center">
      {[
        { titre: 'Durée', detail: '45 min – 1h' },
        { titre: 'Tarif', detail: '60 €' },
        { titre: 'Lieu', detail: 'À votre domicile' },
      ].map(({ titre, detail }) => (
        <div class="flex flex-col gap-2">
          <span class="block w-6 h-px bg-sauge mx-auto"></span>
          <p class="text-xs tracking-cta uppercase text-argile/50">{titre}</p>
          <p class="font-serif text-xl text-argile">{detail}</p>
        </div>
      ))}
    </div>
  </section>

</BaseLayout>
